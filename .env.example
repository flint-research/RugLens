# RugLens API / engine configuration
# Copy to .env and edit, or export these variables in your shell.

# RPC endpoints (comma-separated URL lists are supported)
RUGLENS_RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com
RUGLENS_RPC_URL_BSC=https://bsc-dataseed.binance.org
RUGLENS_RPC_URL_BASE=https://mainnet.base.org
RUGLENS_RPC_URL_SOLANA=https://api.mainnet-beta.solana.com
RUGLENS_SOLANA_ENABLED=true
RUGLENS_SOLANA_CLUSTER_MAX_WALLETS=8
RUGLENS_SOLANA_CLUSTER_SIGNATURE_LIMIT=1000
RUGLENS_SOLANA_CLUSTER_MIN_WALLETS=3
RUGLENS_SOLANA_CREATOR_MEDIUM_PCT=0.10
RUGLENS_SOLANA_CREATOR_HIGH_PCT=0.20
RUGLENS_SOLANA_TOP1_MEDIUM_PCT=0.10
RUGLENS_SOLANA_TOP1_HIGH_PCT=0.20
RUGLENS_SOLANA_TOP10_MEDIUM_PCT=0.30
RUGLENS_SOLANA_TOP10_HIGH_PCT=0.50
RUGLENS_SOLANA_CLUSTER_MEDIUM_PCT=0.10
RUGLENS_SOLANA_CLUSTER_HIGH_PCT=0.30

# Local data, cache, reports, and plugins
RUGLENS_DATA_DIR=~/.ruglens
RUGLENS_CACHE_MAX_BYTES=1073741824

# Simulation resource controls
RUGLENS_SIMULATION_ENABLED=true
RUGLENS_SIMULATION_CONCURRENCY=2
RUGLENS_DETECTOR_TIMEOUT=90
RUGLENS_SIMULATION_TIMEOUT=60

# API
RUGLENS_API_HOST=127.0.0.1
RUGLENS_API_PORT=8000
RUGLENS_API_MAX_CONCURRENT=2
RUGLENS_API_QUEUE_TIMEOUT=1.0
RUGLENS_API_MAX_BODY_BYTES=32768
RUGLENS_API_ALLOW_CUSTOM_RPC=false
RUGLENS_API_ALLOW_PRIVATE_RPC=false

# Optional Slither source analysis (AGPL-3.0 CLI, installed separately)
RUGLENS_SLITHER_ENABLED=false
RUGLENS_SLITHER_BINARY=slither

# Optional community detectors in <data_dir>/plugins/*.py
RUGLENS_PLUGINS_ENABLED=true
